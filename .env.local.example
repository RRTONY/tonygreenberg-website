# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Sanity (editorial content: blog posts, page copy, SEO metadata, images) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Server-side only — write access for Studio/webhooks/publish actions. Never exposed to the client.
SANITY_API_TOKEN=
# Shared secret for the Sanity → Next.js revalidate webhook (api/revalidate).
SANITY_WEBHOOK_SECRET=

# --- Supabase (auth/login, chatbot conversation history) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — bypasses RLS. Used for chat logging. Never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Kit (ConvertKit) newsletter — /api/subscribe uses v3's
# form-subscribe + tag endpoints (api.convertkit.com/v3), confirmed live.
# KIT_API_SECRET (preferred, unlocks tagging) or KIT_API_KEY (subscribe
# only, no tagging) — either works; KIT_FORM_ID is required. ---
KIT_API_KEY=
KIT_API_SECRET=
KIT_FORM_ID=

# --- Stripe (test mode) — reserved for the deferred billing-migration phase (/shop, /subscribe).
# Not read by any route yet; do not build checkout logic without discussing scope first. ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Apps Script email-relay webhook — legacy carryover, not called by any route in this app yet ---
GOOGLE_APPS_SCRIPT_URL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://tonygreenberg.com

# --- MCP server (/api/mcp) — lets Claude Code / Claude Desktop / Claude.ai edit this repo's code
# (via GitHub PRs on admin/mcp-* branches) and Sanity content (drafts only). See
# docs/ai/project_mcp_server.md. Set these in Netlify's dashboard too, not just locally.
# Fine-grained PAT scoped to RRTONY/tonygreenberg-website only: Contents + Pull requests = Read and write,
# Actions + Commit statuses = Read.
GITHUB_TOKEN=
# JSON array, one entry per person, role read | edit | write. An email lets them sign in on
# /oauth/authorize (Claude.ai, Claude Desktop, ChatGPT); the token is optional, for apps that can only
# send a fixed header (Claude Code) — from `openssl rand -hex 32`:
# [{"name":"Jane Doe","email":"jane@example.com","role":"write","token":"<optional, 64 hex>"}]
MCP_ADMIN_USERS=
# Shared team password for the /oauth/authorize sign-in page. Changing it signs everyone out.
MCP_LOGIN_PASSWORD=
# Signs the sign-in codes and access tokens — from `openssl rand -hex 32`. Never reuse another secret.
MCP_OAUTH_SECRET=
# Optional. The public origin (e.g. https://tonygreenberg.com) the OAuth metadata advertises.
# Without it, the request's host is used (and Netlify's main URL for *.netlify.app requests).
MCP_PUBLIC_ORIGIN=
# Optional. Extra comma-separated hosts allowed as sign-in callbacks, beyond claude.ai, claude.com,
# chatgpt.com, chat.openai.com and localhost.
MCP_OAUTH_REDIRECT_HOSTS=
# Optional. Origin seo_check_page fetches. Until DNS cutover, set to the Netlify site URL
# (tonygreenberg.com still serves the legacy app). Falls back to NEXT_PUBLIC_SITE_URL.
MCP_SITE_ORIGIN=

# Netlify (local tooling only, not read by the app). Site ID and URL of the
# tonygreenberg-website project; a personal access token if a script needs the
# Netlify API. Never set these in Netlify itself.
NETLIFY_SITE_ID=
NETLIFY_SITE_URL=
NETLIFY_AUTH_TOKEN=
