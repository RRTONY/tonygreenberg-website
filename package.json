{
  "name": "tonygreenberg-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "env -u NODE_ENV next dev",
    "build": "env -u NODE_ENV next build",
    "start": "env -u NODE_ENV next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck",
    "test": "vitest run",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "migrate:content": "tsx scripts/import-managed-content.ts",
    "migrate:content:refresh": "tsx scripts/import-managed-content.ts --refresh-existing"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "mysql2": "^3.24.4",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "marked": "^18.0.10",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.17.0"
}
